%% rtex-capture.sty — record unit/paragraph contexts, row placements and page display lists
%% during a normal LuaLaTeX run. Adds no nodes; output is unchanged (verified by tests).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rtex-capture}[2026/10/07 v0.0.2 rtex layout capture]
\RequirePackage{luatexbase}
\directlua{
  rtex_capture = dofile(kpse.find_file("rtex-capture.lua", "lua") or "rtex-capture.lua")
  rtex_capture.setup{ jobname = tex.jobname }
}
\AddToHook{begindocument/end}{\directlua{rtex_capture.begin_document()}}
\AddToHook{para/begin}{\directlua{rtex_capture.parbegin()}}
\AddToHook{para/after}{\directlua{rtex_capture.parafter()}}
% Pages are read from the box LuaTeX ships (pre_shipout_filter, registered at
% \begin{document}), which holds the shipout/background and foreground material (eso-pic,
% pdfpages, watermarks) that \ShipoutBox lacks in shipout/before; the page attributes are
% taken here (pdflscape's /Rotate).
\AddToHook{shipout/before}{\directlua{rtex_capture.page_attr("\luaescapestring{\the\pdfvariable pageattr}")}}
\AddToHook{cmd/@outputpage/before}{\directlua{rtex_capture.output_begin()}}
\AddToHook{cmd/@outputpage/after}{\directlua{rtex_capture.output_end()}}
\AddToHook{cmd/@afterheading/before}{\directlua{rtex_capture.afterheading()}}
\AddToHook{enddocument/afterlastpage}{\directlua{rtex_capture.finish()}}
% Unit boundaries: block environments and sectioning commands. Extra block environments
% (theorem-like) come from $RTEX_UNIT_ENVS, comma separated.
\directlua{
  token.set_macro("rtex@blockenvs", table.concat(rtex_capture.BLOCK_ENVS, ","))
  token.set_macro("rtex@headings", table.concat(rtex_capture.HEADINGS, ","))
}
\def\rtex@hookenv#1{%
  \edef\rtex@tmp{\noexpand\AddToHook{env/#1/begin}{\noexpand\directlua{rtex_capture.envbegin("#1")}}%
    \noexpand\AddToHook{env/#1/after}{\noexpand\directlua{rtex_capture.envafter("#1")}}}%
  \rtex@tmp}
\def\rtex@hookheading#1{%
  \edef\rtex@tmp{\noexpand\AddToHook{cmd/#1/before}{\noexpand\directlua{rtex_capture.heading("#1")}}}%
  \rtex@tmp}
\@for\rtex@n:=\rtex@blockenvs\do{\expandafter\rtex@hookenv\expandafter{\rtex@n}}
\@for\rtex@n:=\rtex@headings\do{\expandafter\rtex@hookheading\expandafter{\rtex@n}}
% Picture cache (see rtex-capture.lua): the begin macro of each picture environment is wrapped
% so a picture the session's manifest lists is replaced by the cached region of an earlier
% pass's PDF, and every other one is tagged so its page position is recorded.
\newcatcodetable\rtexcapturecct
{\makeatletter\savecatcodetable\rtexcapturecct}
\directlua{rtex_capture.set_cct(\number\rtexcapturecct)}
\def\rtex@picns{rtex_capture}
\directlua{token.set_macro("rtex@picenvs", table.concat(rtex_capture.PICTURE_ENVS, ","))}
\input{rtex-pic.tex}
\AddToHook{begindocument/end}{\rtex@wrappicall}
% pgf's PDF literals, made from Lua so the display list can read their operators (see
% rtex_capture.literal). \protected: like the primitive, never expanded inside an \edef.
\def\rtex@hookpgfliterals{%
  \ifdefined\pgfsys@invoke
    \protected\def\pgfsys@invoke##1{\directlua{rtex_capture.literal("\luaescapestring{##1}")}}%
    \protected\def\pgfsys@color@unstacked##1{\directlua{rtex_capture.literal("\luaescapestring{\csname\string\color@##1\endcsname}")}}%
  \fi}
\AddToHook{begindocument/before}{\rtex@hookpgfliterals}
% pgf's axial and radial shadings: record what each saved form paints (rtex_capture.shading).
% The coordinates are computed exactly as pgfsys-luatex.def computes them. Installed when the
% driver is read (shadings declared in the preamble are saved there) and, failing that, at
% \begin{document}.
\def\rtex@shadinginfo#1#2#3#4{{%
  \pgf@parsefunc{#4}%
  \ifx#1r%
    \pgf@process{#3}\pgf@xa=\pgf@x \pgf@ya=\pgf@y
    \pgf@process{\pgfpoint{\pgf@max}{\pgf@max}}%
    \advance\pgf@xa by \pgf@x \advance\pgf@ya by \pgf@y
    \pgf@sys@bp@correct{\pgf@x}\pgf@sys@bp@correct{\pgf@y}%
    \pgf@sys@bp@correct{\pgf@xa}\pgf@sys@bp@correct{\pgf@ya}%
    \edef\rtex@tmp{\pgf@sys@tonumber{\pgf@xa} \pgf@sys@tonumber{\pgf@ya} \pgf@doma\space \pgf@sys@tonumber{\pgf@x} \pgf@sys@tonumber{\pgf@y} \pgf@domb}%
    \def\rtex@kind{radial}\def\rtex@ext{true false}%
  \else
    \ifx#1h\edef\rtex@tmp{\pgf@doma\space0 \pgf@domb\space0}\else\edef\rtex@tmp{0 \pgf@doma\space0 \pgf@domb}\fi
    \def\rtex@kind{axial}\def\rtex@ext{false false}%
  \fi
  \directlua{rtex_capture.shading(\the\lastsavedboxresourceindex, "\rtex@kind",
    "\luaescapestring{\pgf@shading@device}", "\luaescapestring{\pgf@pdfparseddomain}",
    "\luaescapestring{\rtex@tmp}", "\luaescapestring{\pgf@pdfparsedfunction}", "\rtex@ext")}}}
\def\rtex@hookpgfshadings{%
  \ifdefined\rtex@pgf@horishading\else\ifdefined\pgfsys@horishading
    \let\rtex@pgf@horishading\pgfsys@horishading
    \def\pgfsys@horishading##1##2##3{\rtex@pgf@horishading{##1}{##2}{##3}\rtex@shadinginfo h{##2}{}{##3}}%
    \let\rtex@pgf@vertshading\pgfsys@vertshading
    \def\pgfsys@vertshading##1##2##3{\rtex@pgf@vertshading{##1}{##2}{##3}\rtex@shadinginfo v{##2}{}{##3}}%
    \let\rtex@pgf@radialshading\pgfsys@radialshading
    \def\pgfsys@radialshading##1##2##3{\rtex@pgf@radialshading{##1}{##2}{##3}\rtex@shadinginfo r{}{##2}{##3}}%
  \fi\fi}
\AddToHook{file/pgfsys-luatex.def/after}{\rtex@hookpgfshadings}
\AddToHook{begindocument/before}{\rtex@hookpgfshadings}
% pgf's tiling patterns (the patterns library): record each pattern pgfsys-luatex.def writes, as
% it writes it (rtex_capture.pattern). The bbox and steps are in \pgf@xa..\pgf@yc, the matrix's
% translation is computed as the driver computes it, and the cell is the protocolled code.
\def\rtex@patterninfo#1#2#3#4#5#6#7#8#9{{%
  \pgfutil@tempdima=#6\relax \pgfutil@tempdimb=#7\relax
  \pgf@sys@bp@correct\pgfutil@tempdima \pgf@sys@bp@correct\pgfutil@tempdimb
  \directlua{rtex_capture.pattern("\luaescapestring{#1}", \ifnum#9=0 2\else 1\fi,
    "\pgf@sys@tonumber\pgf@xa\space\pgf@sys@tonumber\pgf@ya\space\pgf@sys@tonumber\pgf@xb\space\pgf@sys@tonumber\pgf@yb",
    "\pgf@sys@tonumber\pgf@xc\space\pgf@sys@tonumber\pgf@yc",
    "\luaescapestring{#2 #3 #4 #5} \pgf@sys@tonumber\pgfutil@tempdima\space\pgf@sys@tonumber\pgfutil@tempdimb",
    "\luaescapestring{#8}")}}}
\def\rtex@hookpgfpatterns{%
  \ifdefined\rtex@pgf@declarepattern\else\ifdefined\pgfsys@@declarepattern
    \let\rtex@pgf@declarepattern\pgfsys@@declarepattern
    \def\pgfsys@@declarepattern##1##2##3##4##5##6##7##8##9{%
      \rtex@pgf@declarepattern{##1}{##2}{##3}{##4}{##5}{##6}{##7}{##8}{##9}%
      \rtex@patterninfo{##1}{##2}{##3}{##4}{##5}{##6}{##7}{##8}{##9}}%
  \fi\fi}
\AddToHook{file/pgfsys-luatex.def/after}{\rtex@hookpgfpatterns}
\AddToHook{begindocument/before}{\rtex@hookpgfpatterns}
% imakeidx: record the index commands instead of running them (rtex-capture.lua, index_command)
\AddToHook{package/imakeidx/after}{%
  \def\imki@exec#1{\directlua{rtex_capture.index_command("\luaescapestring{#1}")}}%
  \def\imki@finalmessage#1{\directlua{rtex_capture.index_command(
    "\luaescapestring{\imki@program\imki@options#1.idx}")}}}
% Map image resource indices to files so IMAGE display-list items can name their source.
% luatex.def saves an image once and reuses it through \csname <file> image<attributes>\endcsname
% (\useimageresource <n>). Two numberings meet here: <n> and \lastsavedimageresourceindex count
% every saved resource (box resources too: pgf's shadings), the image rule an IMAGE item comes
% from carries the image's own index. The cached macro is set in a scratch box and the rule's
% index read from it: right for repeated images and after box resources.
\newbox\rtex@imgbox
\AddToHook{package/graphicx/after}{%
  \AddToHook{cmd/Gin@setfile/after}{%
    \setbox\rtex@imgbox\hbox{\csname\Gin@base\Gin@ext\space image%
      \ifdefined\Gin@attr@hash\Gin@attr@hash\fi\endcsname}%
    \directlua{rtex_capture.image(\number\lastsavedimageresourceindex,
      "\luaescapestring{\Gin@base\Gin@ext}", "\luaescapestring{\Gin@page}",
      \number\lastsavedimageresourcepages,
      "\luaescapestring{\Gin@base\Gin@ext\space image\ifdefined\Gin@attr@hash\Gin@attr@hash\fi}",
      \number\rtex@imgbox)}}}
\endinput
